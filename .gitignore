# --- Python / venv ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- atompipe ---
# The ledger IS a source of truth — claims, evidence, provenance, decisions — and
# the run history is the record of what was checked when. Both stay tracked.
# Only the scratch a gate sweep writes is ignored.
.atompipe/out/
.selftest-out/

# --- generated geometry ---
# build/ is regenerated by `python tools/build_geometry.py` from model/boat.py,
# which is the only source of truth (atompipe rule 1). The print-ready STLs in
# build/print/ ARE tracked, because they are what a builder downloads and because
# the readiness report's verdicts were made against exactly those files.
build/*.stl

# --- OS / editor ---
.DS_Store
*.swp
*~
.vscode/
*:Zone.Identifier
